# ── SUPABASE ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here        # SERVER ONLY — never prefix with NEXT_PUBLIC_

# ── CLOUDINARY ─────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret                       # SERVER ONLY

# ── CLOUDFLARE R2 (if used) ─────────────────────────────────────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key                 # SERVER ONLY
R2_BUCKET_NAME=albaeon-files
R2_PUBLIC_URL=https://files.albaeon.com

# ── UPSTASH REDIS ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here                    # SERVER ONLY

# ── RESEND (EMAIL) ─────────────────────────────────────────────
RESEND_API_KEY=re_your-key-here                             # SERVER ONLY
EMAIL_FROM=orders@albaeon.com
EMAIL_SUPPORT=support@albaeon.com

# ── RAZORPAY ───────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key-id            # Safe to expose — used in frontend modal
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret                         # SERVER ONLY
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret                 # SERVER ONLY

# ── GELATO ─────────────────────────────────────────────────────
GELATO_API_KEY=your-gelato-api-key                          # SERVER ONLY
GELATO_STORE_ID=your-gelato-store-id
GELATO_WEBHOOK_SECRET=your-gelato-webhook-secret            # SERVER ONLY

# ── BANIAN CITY (Google Form) ──────────────────────────────────
BANIAN_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse
BANIAN_FIELD_ORDER_NUMBER=entry.order-number
BANIAN_FIELD_NAME=entry.name
BANIAN_FIELD_PHONE=entry.phone
BANIAN_FIELD_ADDRESS=entry.address
BANIAN_FIELD_CITY=entry.city
BANIAN_FIELD_STATE=entry.state
BANIAN_FIELD_PINCODE=entry.pincode
BANIAN_FIELD_PRODUCT_SKU=entry.product-sku
BANIAN_FIELD_COLOR=entry.color
BANIAN_FIELD_SIZE=entry.size
BANIAN_FIELD_QUANTITY=entry.quantity

# ── INTERNAL SECURITY ──────────────────────────────────────────
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your-64-char-random-hex-string          # SERVER ONLY — required by /api/fulfill/* routes

# ── COMPANY INFO (for invoices) ──────────────────
BENEFICIARY_NAME=Your Business Name
BANK_NAME=Your Bank
BANK_ACCOUNT_NUMBER=your-account-number
BANK_IFSC_CODE=IFSC0001234
BANK_BRANCH=Your Branch

# ── SITE ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://albaeon.com

# ── GOOGLE ANALYTICS (optional at launch) ──────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
